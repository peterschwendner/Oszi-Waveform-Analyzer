# Visual Studio
.vs/
*.suo
*.user

# Build output (the release exe in Compiled/ is tracked on purpose)
SourceCode/obj/
SourceCode/bin/
*.pdb

# .NET runtime files copied into Compiled/ when building without the .NET 4.0 targeting pack
Compiled/mscorlib.dll
Compiled/*.nlp
Compiled/de/

# Empty config file created by Visual Studio
SourceCode/app.config

# WAV files for testing (e.g. oscilloscope music) are copyrighted and must not be published
Compiled/Samples/*.wav

# Exports of the Waterfall FFT (own measurements, default file names)
Compiled/Samples/Waterfall *.csv
Compiled/Samples/Waterfall *.png
Compiled/Samples/LiveXY *.png
